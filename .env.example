# Public site URL — canonical tags, sitemap, Open Graph.
NEXT_PUBLIC_SITE_URL=https://www.eitanuner.co.il

# ---------------------------------------------------------------------------
# Editor auth (required for /editor to be reachable).
#
# Generate both with:  npx tsx scripts/set-password.mts "your-password"
#
# Without them /editor returns 503 rather than being left open.
# ---------------------------------------------------------------------------
AUTH_SECRET=
EDITOR_PASSWORD_HASH=

# ---------------------------------------------------------------------------
# Storage (required to save anything in production).
#
# Everything Eitan edits — pages, site design, uploaded photos — is stored in
# Vercel Blob, inside the same Vercel project. Connecting a Blob store
# (Vercel → Storage → Blob → Connect Project) sets this variable automatically.
# Saves are live immediately; no commit, no rebuild.
#
# Leave blank in development: writes go to ./.data/ on the local disk instead.
# ---------------------------------------------------------------------------
BLOB_READ_WRITE_TOKEN=
