# Public site URL — used for canonical tags, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://www.eitanuner.co.il

# ---------------------------------------------------------------------------
# Sanity (optional).
#
# Leave these blank and the site renders from src/lib/content.ts. That is the
# state it ships in, so it can go live before any content migration. Fill them
# in and published Sanity documents take over, with content.ts as the fallback.
#
# Create a project at https://sanity.io/manage, then copy the project id here.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01
