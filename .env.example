# Public site URL — canonical tags, sitemap, Open Graph.
NEXT_PUBLIC_SITE_URL=https://www.eitanuner.co.il

# ---------------------------------------------------------------------------
# Editor auth (required for /editor to be reachable).
#
# Generate both with:  npx tsx scripts/set-password.mts "your-password"
#
# Without them /editor returns 503 rather than being left open.
# ---------------------------------------------------------------------------
AUTH_SECRET=
EDITOR_PASSWORD_HASH=

# ---------------------------------------------------------------------------
# Storage (required to publish or upload in production).
#
# The repo is the content store: publishing commits to content/pages/*.json and
# uploads commit to public/uploads/, each triggering a rebuild. No database and
# no media service — nothing extra to hand over with the site.
#
# GITHUB_TOKEN needs a fine-grained PAT scoped to this repo with
# "Contents: read and write" and nothing else.
#
# Leave blank in development: writes go to the local filesystem instead.
# ---------------------------------------------------------------------------
GITHUB_TOKEN=
GITHUB_REPO=owner/eitan-uner-website
GITHUB_BRANCH=main
