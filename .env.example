# Public site URL — canonical tags, sitemap, Open Graph.
NEXT_PUBLIC_SITE_URL=https://www.eitanuner.co.il

# ---------------------------------------------------------------------------
# Editor auth (required for /editor to be reachable).
#
# Generate both values with:
#   npx tsx scripts/set-password.mts "your-password"
#
# Without them, /editor and the editing APIs fail closed with a 503 rather than
# being left open.
# ---------------------------------------------------------------------------
AUTH_SECRET=
EDITOR_PASSWORD_HASH=
